// Nextflow configuration file

// Enable conda by default
conda.enabled = true
conda.createOptions = '-y'

params.container_image = null
params.container_run_options = ''

// Process configuration
process {
    // Default settings
    cpus = 24
    memory = '8 GB'
    time = '2h'
    
    // Process-specific settings
    withName: FETCHM {
        conda = 'envs/fetchm.yaml'
        cpus = 24
        memory = '8 GB'
        time = '2h'
    }

    withName: FETCHM_ENV_VERSIONS {
        conda = 'envs/fetchm.yaml'
        cpus = 1
        memory = '1 GB'
        time = '10m'
    }

    withName: GENERATE_NCBI_TAXON_INPUT {
        conda = 'envs/fetchm.yaml'
        cpus = 1
        memory = '1 GB'
        time = '30m'
    }

    withName: SEQUENCE_QC {
        conda = 'envs/fetchm.yaml'
        cpus = 2
        memory = '4 GB'
        time = '30m'
    }
    
    withName: ABRICATE {
        conda = 'envs/abricate.yaml'
        cpus = { params.threads as int }
        memory = '16 GB'
        time = '1h'
    }

    withName: ABRICATE_ENV_VERSIONS {
        conda = 'envs/abricate.yaml'
        cpus = 1
        memory = '1 GB'
        time = '10m'
    }

    withName: PANR2_COMPREHENSIVE_ENV_VERSIONS {
        conda = 'envs/panr2_comprehensive.yaml'
        cpus = 1
        memory = '2 GB'
        time = '30m'
    }

    withName: AMRFINDERPLUS_ENV_VERSIONS {
        conda = 'envs/amrfinderplus.yaml'
        cpus = 1
        memory = '2 GB'
        time = '30m'
    }

    withName: CHECKM2_ENV_VERSIONS {
        conda = 'envs/checkm2.yaml'
        cpus = 1
        memory = '1 GB'
        time = '10m'
    }

    withName: CHECKM2_QC {
        conda = 'envs/checkm2.yaml'
        cpus = { params.checkm2_threads ? params.checkm2_threads as int : Math.min(params.threads as int, 4) }
        memory = '8 GB'
        time = '24h'
    }

    withName: GTDBTK_ENV_VERSIONS {
        conda = 'envs/gtdbtk.yaml'
        cpus = 1
        memory = '1 GB'
        time = '10m'
    }

    withName: GTDBTK_QC {
        conda = 'envs/gtdbtk.yaml'
        cpus = 24
        memory = '64 GB'
        time = '12h'
    }

    withName: ANI_ENV_VERSIONS {
        conda = 'envs/ani.yaml'
        cpus = 1
        memory = '1 GB'
        time = '10m'
    }

    withName: ANI_ANALYSIS {
        conda = 'envs/ani.yaml'
        cpus = { Math.min(params.threads as int, 8) }
        memory = '8 GB'
        time = '4h'
    }

    withName: QUAST_ENV_VERSIONS {
        conda = 'envs/quast.yaml'
        cpus = 1
        memory = '1 GB'
        time = '10m'
    }

    withName: QUAST_QC {
        conda = 'envs/quast.yaml'
        cpus = 8
        memory = '8 GB'
        time = '3h'
    }

    withName: MASH_ENV_VERSIONS {
        conda = 'envs/mash.yaml'
        cpus = 1
        memory = '1 GB'
        time = '10m'
    }

    withName: MASH_PRESCREEN {
        conda = 'envs/mash.yaml'
        cpus = { Math.min(params.threads as int, 4) }
        memory = '4 GB'
        time = '2h'
    }

    withName: MOBSUITE_ENV_VERSIONS {
        conda = 'envs/mobsuite.yaml'
        cpus = 1
        memory = '1 GB'
        time = '10m'
    }

    withName: MOBSUITE_ANALYSIS {
        conda = 'envs/mobsuite.yaml'
        cpus = { params.mobsuite_jobs ? params.mobsuite_jobs as int : Math.min(params.threads as int, 8) }
        memory = '8 GB'
        time = '6h'
    }

    withName: GENOMAD_ENV_VERSIONS {
        conda = { params.genomad_use_host_env ? false : 'envs/genomad.yaml' }
        cpus = 1
        memory = '1 GB'
        time = '10m'
    }

    withName: GENOMAD_PROPHAGE {
        conda = { params.genomad_use_host_env ? false : 'envs/genomad.yaml' }
        cpus = { Math.min(params.threads as int, (params.genomad_jobs ? params.genomad_jobs as int : Math.min(params.threads as int, 2)) * (params.genomad_threads_per_sample ? params.genomad_threads_per_sample as int : 1)) }
        memory = '8 GB'
        time = '12h'
    }

    withName: ORGANISM_TYPING_ENV_VERSIONS {
        conda = 'envs/organism_typing.yaml'
        cpus = 1
        memory = '1 GB'
        time = '10m'
    }

    withName: ORGANISM_SPECIFIC_TYPING {
        conda = 'envs/organism_typing.yaml'
        cpus = { params.kleborate_jobs ? params.kleborate_jobs as int : Math.min(params.threads as int, 8) }
        memory = '8 GB'
        time = '4h'
    }

    withName: AMRFINDERPLUS_ANALYSIS {
        conda = 'envs/amrfinderplus.yaml'
        cpus = { params.amrfinderplus_jobs ? params.amrfinderplus_jobs as int : params.threads as int }
        memory = '8 GB'
        time = '4h'
    }

    withName: COMBINED_QC {
        conda = 'envs/fetchm.yaml'
        cpus = 1
        memory = '2 GB'
        time = '30m'
    }

    withName: EXPORT_PANR2_INPUTS {
        conda = 'envs/fetchm.yaml'
        cpus = 1
        memory = '2 GB'
        time = '15m'
    }
    
    withName: PANR {
        conda = 'envs/panr2_comprehensive.yaml'
        cpus = 24
        memory = '8 GB'
        time = '30m'
    }

    withName: PANR2_COMPREHENSIVE {
        conda = 'envs/panr2_comprehensive.yaml'
        cpus = 8
        memory = '8 GB'
        time = '8h'
    }

    withName: PANR2_FEATURE_RUNNERS {
        conda = 'envs/panr2_comprehensive.yaml'
        cpus = { params.threads as int }
        memory = '8 GB'
        time = '8h'
    }
    
    withName: COLLECT_RESULTS {
        conda = false
        cpus = 1
        memory = '2 GB'
        time = '10m'
    }
}

// Executor configuration
executor {
    name = 'local'
    cpus = 24
    memory = '16 GB'
}

// Report configuration
report {
    enabled = true
    overwrite = true     
    file = "pipeline_report.html"
}

timeline {
    enabled = true
    overwrite = true    
    file = "pipeline_timeline.html"
}

trace {
    enabled = true
    overwrite = true      
    file = "pipeline_trace.txt"
}

dag {
    enabled = true
    overwrite = true      
    file = "pipeline_dag.svg"
}

// Manifest
manifest {
    name = 'fetchm-abricate-panr-pipeline'
    description = 'A pipeline for running panresistome analysis'
    version = '0.6.0'
    nextflowVersion = '>=21.0.0'
}

// Profiles for different execution modes
profiles {
    conda {
        process.conda = true
    }

    mamba {
        process.conda = true
        conda.useMamba = true
    }

    lowmem {
        params.threads = 4
        params.checkm2_threads = 1
        params.fetchm2_download_workers = 1
        params.panr2_native_feature_runner_mode = 'serial'
    }

    desktop_parallel {
        params.threads = 16
        params.checkm2_threads = 2
        params.fetchm2_download_workers = 2
        params.panr2_native_feature_runner_mode = 'parallel'
    }

    workstation {
        params.threads = 16
        params.checkm2_threads = 4
        params.fetchm2_download_workers = 2
        params.panr2_native_feature_runner_mode = 'parallel'
    }

    large {
        params.large_dataset = true
        params.report_mode = 'compact'
        params.max_features_heatmap = 150
        params.max_features_network = 150
        params.max_metadata_columns = 20
        params.top_n_features_per_database = 50
        params.skip_heavy_interactive_plots = true
    }

    genomad_host {
        params.genomad_use_host_env = true
    }

    docker {
        conda.enabled = false
        process.conda = false
        docker.enabled = true
        docker.runOptions = params.container_run_options ? "${params.container_run_options} -v ${baseDir}:${baseDir}" : "-v ${baseDir}:${baseDir}"
        process.container = params.container_image ?: 'ghcr.io/tasnimul-arabi-anik/panresistome:experimental'
    }

    apptainer {
        conda.enabled = false
        process.conda = false
        params.panr2_update_abricate_db = false
        env.MPLCONFIGDIR = '/tmp'
        apptainer.enabled = true
        apptainer.autoMounts = true
        apptainer.runOptions = params.container_run_options ? "${params.container_run_options} -B ${baseDir}:${baseDir}" : "-B ${baseDir}:${baseDir}"
        process.container = params.container_image ?: 'docker://ghcr.io/tasnimul-arabi-anik/panresistome:experimental'
    }

    singularity {
        conda.enabled = false
        process.conda = false
        params.panr2_update_abricate_db = false
        env.MPLCONFIGDIR = '/tmp'
        singularity.enabled = true
        singularity.autoMounts = true
        singularity.runOptions = params.container_run_options ? "${params.container_run_options} -B ${baseDir}:${baseDir}" : "-B ${baseDir}:${baseDir}"
        process.container = params.container_image ?: 'docker://ghcr.io/tasnimul-arabi-anik/panresistome:experimental'
    }

    slurm {
        executor.name = 'slurm'
        process.executor = 'slurm'
        executor.queueSize = { params.slurm_queue_size ? params.slurm_queue_size as int : 50 }
        process.queue = { params.slurm_queue ?: null }
        process.clusterOptions = {
            def options = []
            if (params.slurm_account) {
                options << "--account=${params.slurm_account}"
            }
            if (params.slurm_cluster_options) {
                options << params.slurm_cluster_options
            }
            return options.join(' ')
        }
    }

    test {
        conda.enabled = false
        params.local_samples = "$baseDir/tests/fixtures/local_samples"
        params.outdir = "$baseDir/test_output"
        params.capture_versions = false
        params.threads = 1
        params.sequence_qc_engine = 'python'
        params.qc_filter = true
        params.run_checkm2 = false
        params.run_gtdbtk = false
        params.run_quast = false
        params.run_ani = false
        params.run_mash = false
        params.representative_only = false
        params.stop_after_qc = true
        process.conda = false
        process.cpus = 1
        process.memory = '1 GB'
        process {
            withName: SEQUENCE_QC {
                cpus = 1
                memory = '1 GB'
            }
            withName: ABRICATE {
                cpus = 1
                memory = '1 GB'
            }
            withName: ANI_ANALYSIS {
                cpus = 1
                memory = '1 GB'
            }
            withName: MASH_PRESCREEN {
                cpus = 1
                memory = '1 GB'
            }
            withName: ISFINDER_BLAST {
                cpus = 1
                memory = '1 GB'
            }
            withName: MOBSUITE_ANALYSIS {
                cpus = 1
                memory = '1 GB'
            }
            withName: GENOMAD_PROPHAGE {
                cpus = 1
                memory = '1 GB'
            }
            withName: ORGANISM_SPECIFIC_TYPING {
                cpus = 1
                memory = '1 GB'
            }
            withName: EXPORT_PANR2_INPUTS {
                cpus = 1
                memory = '1 GB'
            }
            withName: COLLECT_RESULTS {
                cpus = 1
                memory = '1 GB'
            }
        }
        executor.cpus = 1
        executor.memory = '2 GB'
        report.enabled = false
        timeline.enabled = false
        trace.enabled = false
        dag.enabled = false
    }
}

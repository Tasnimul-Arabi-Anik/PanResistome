// Nextflow configuration file

// Enable conda by default
conda.enabled = true

// Process configuration
process {
    // Default settings
    cpus = 24
    memory = '8 GB'
    time = '2h'
    
    // Process-specific settings
    withName: FETCHM {
        conda = 'envs/fetchm.yaml'
        cpus = 24
        memory = '8 GB'
        time = '2h'
    }

    withName: FETCHM_ENV_VERSIONS {
        conda = 'envs/fetchm.yaml'
        cpus = 1
        memory = '1 GB'
        time = '10m'
    }

    withName: SEQUENCE_QC {
        conda = 'envs/fetchm.yaml'
        cpus = 2
        memory = '4 GB'
        time = '30m'
    }
    
    withName: ABRICATE {
        conda = 'envs/abricate.yaml'
        cpus = 24
        memory = '16 GB'
        time = '1h'
    }

    withName: ABRICATE_ENV_VERSIONS {
        conda = 'envs/abricate.yaml'
        cpus = 1
        memory = '1 GB'
        time = '10m'
    }

    withName: CHECKM2_ENV_VERSIONS {
        conda = 'envs/checkm2.yaml'
        cpus = 1
        memory = '1 GB'
        time = '10m'
    }

    withName: CHECKM2_QC {
        conda = 'envs/checkm2.yaml'
        cpus = 8
        memory = '8 GB'
        time = '6h'
    }

    withName: GTDBTK_ENV_VERSIONS {
        conda = 'envs/gtdbtk.yaml'
        cpus = 1
        memory = '1 GB'
        time = '10m'
    }

    withName: GTDBTK_QC {
        conda = 'envs/gtdbtk.yaml'
        cpus = 24
        memory = '64 GB'
        time = '12h'
    }

    withName: ANI_ENV_VERSIONS {
        conda = 'envs/ani.yaml'
        cpus = 1
        memory = '1 GB'
        time = '10m'
    }

    withName: ANI_ANALYSIS {
        conda = 'envs/ani.yaml'
        cpus = 8
        memory = '8 GB'
        time = '4h'
    }

    withName: QUAST_ENV_VERSIONS {
        conda = 'envs/quast.yaml'
        cpus = 1
        memory = '1 GB'
        time = '10m'
    }

    withName: QUAST_QC {
        conda = 'envs/quast.yaml'
        cpus = 8
        memory = '8 GB'
        time = '3h'
    }

    withName: MASH_ENV_VERSIONS {
        conda = 'envs/mash.yaml'
        cpus = 1
        memory = '1 GB'
        time = '10m'
    }

    withName: MASH_PRESCREEN {
        conda = 'envs/mash.yaml'
        cpus = 4
        memory = '4 GB'
        time = '2h'
    }

    withName: COMBINED_QC {
        conda = 'envs/fetchm.yaml'
        cpus = 1
        memory = '2 GB'
        time = '30m'
    }

    withName: EXPORT_PANR2_INPUTS {
        conda = 'envs/fetchm.yaml'
        cpus = 1
        memory = '2 GB'
        time = '15m'
    }
    
    withName: PANR {
        conda = 'envs/fetchm.yaml'
        cpus = 24
        memory = '8 GB'
        time = '30m'
    }
    
    withName: COLLECT_RESULTS {
        conda = false
        cpus = 1
        memory = '2 GB'
        time = '10m'
    }
}

// Executor configuration
executor {
    name = 'local'
    cpus = 24
    memory = '16 GB'
}

// Report configuration
report {
    enabled = true
    overwrite = true     
    file = "pipeline_report.html"
}

timeline {
    enabled = true
    overwrite = true    
    file = "pipeline_timeline.html"
}

trace {
    enabled = true
    overwrite = true      
    file = "pipeline_trace.txt"
}

dag {
    enabled = true
    overwrite = true      
    file = "pipeline_dag.svg"
}

// Manifest
manifest {
    name = 'fetchm-abricate-panr-pipeline'
    description = 'A pipeline for running panresistome analysis'
    version = '1.0.0'
    nextflowVersion = '>=21.0.0'
}

// Profiles for different execution modes
profiles {
    conda {
        process.conda = true
    }

    test {
        conda.enabled = false
        params.local_samples = "$baseDir/tests/fixtures/local_samples"
        params.outdir = "$baseDir/test_output"
        params.capture_versions = false
        params.sequence_qc_engine = 'python'
        params.qc_filter = true
        params.run_checkm2 = false
        params.run_gtdbtk = false
        params.run_quast = false
        params.run_ani = false
        params.run_mash = false
        params.representative_only = false
        params.stop_after_qc = true
        process.conda = false
        process.cpus = 1
        process.memory = '1 GB'
        process {
            withName: SEQUENCE_QC {
                cpus = 1
                memory = '1 GB'
            }
            withName: COLLECT_RESULTS {
                cpus = 1
                memory = '1 GB'
            }
        }
        executor.cpus = 1
        executor.memory = '2 GB'
        report.enabled = false
        timeline.enabled = false
        trace.enabled = false
        dag.enabled = false
    }
}
